; اختبارات الرياضيات
; ==================

; نستورد الدوال من المشروع
; (نفترض أنها في main.lisp — محمّلة مسبقاً)

(اختبار "جمع 1 و 2 = 3"
    (نظير (+ 1 2) 3))

(اختبار "ضرب 3 في 4 = 12"
    (نظير (* 3 4) 12))

(اختبار "طرح 10 من 7 = 3"
    (نظير (- 10 7) 3))

(اختبار "طول السلام = 6"
    (نظير (طول_نص "السلام") 6))
