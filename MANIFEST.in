# ملفات أساسية
include README.md
include LICENSE
include CHANGELOG.md
include VERSION

# ملفات فلسفية
include MESSAGE.md
include WARNING.md
include MANIFESTO.md
include PROVENANCE.md

# كود المصدر
recursive-include src/quraysh *.py
